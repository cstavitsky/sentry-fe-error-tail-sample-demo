# Copy to .env and fill in. Never commit .env.

# --- Sentry DSNs (Project Settings > Client Keys) ---
SENTRY_DSN_FE=https://<public_key>@o<orgId>.ingest.sentry.io/<fe_project_id>
SENTRY_DSN_BE=https://<public_key>@o<orgId>.ingest.sentry.io/<be_project_id>

# --- Sentry OTLP (Client Keys > OpenTelemetry (OTLP)); used by the collector ---
# Traces endpoint, including /v1/traces:
SENTRY_OTLP_FE_ENDPOINT=https://o<orgId>.ingest.sentry.io/api/<fe_project_id>/integration/otlp/v1/traces
# Full x-sentry-auth header value:
SENTRY_OTLP_FE_AUTH=sentry sentry_key=<fe_public_key>
SENTRY_OTLP_BE_ENDPOINT=https://o<orgId>.ingest.sentry.io/api/<be_project_id>/integration/otlp/v1/traces
SENTRY_OTLP_BE_AUTH=sentry sentry_key=<be_public_key>

# --- Sentry API (tests only; read-only token) ---
# Your org slug. (The demo maintainer's own org slug lives only in a local, uncommitted .env.)
SENTRY_ORG=your-org
SENTRY_PROJECT_FE=tail-sample-demo-fe
SENTRY_PROJECT_BE=tail-sample-demo-be
SENTRY_AUTH_TOKEN=

# --- Collector tail sampling ---
# A trace is kept when one backend SERVER span takes >= this many ms (keep <= your slow-DB request time)
TAIL_LATENCY_MS=1000
DECISION_WAIT=30s
# demo.yaml (demo overlay: file exporters + test-only demo.force_keep policy)
# | config.yaml (plain customer config only; verify_sentry.py needs demo.yaml)
COLLECTOR_OVERLAY=demo.yaml

# --- Backend ---
# otlp (OTel spans -> collector; Sentry = errors + logs) | sentry (control: Sentry SDK tracing)
# Leave at otlp: `make perf MODE=sentry` switches temporarily and switches back.
BE_TRACING_MODE=otlp
SENTRY_PYTHON_VERSION=2.56.0
# 1 = re-stamp log trace/span ids from the OTel span (workaround for sentry-sdk >= 2.59.0)
FIX_LOG_SPAN_ID=1
